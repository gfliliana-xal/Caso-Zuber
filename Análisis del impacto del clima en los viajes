result_07.head(10)
rom scipy import stats
import numpy as np

# 1. DEFINIR LAS HIPÓTESIS
print("=== PRUEBA DE HIPÓTESIS ===")
print("H₀: μ_lluvia = μ_no_lluvia (La duración promedio de los viajes no cambia los sábados lluviosos)")
print("H₁: μ_lluvia > μ_no_lluvia (La duración promedio de los viajes sí cambia los sábados lluviosos)")
print("Nivel de significancia: α = 0.05")
grupo_bad = result_07[result_07['weather_conditions'] == 'Bad']['duration_seconds']
grupo_good = result_07[result_07['weather_conditions'] == 'Good']['duration_seconds']

t_stat, p_value = stats.ttest_ind(grupo_bad, grupo_good,alternative='greater')

print("=== RESULTADOS DE LA PRUEBA ===")
print(f"Estadístico t: {t_stat:.4f}")
print(f"Valor p: {p_value:.6f}")
print(f"Valor crítico (α = 0.05): {p_value < 0.05}")
